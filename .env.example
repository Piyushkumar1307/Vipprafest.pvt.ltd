## SMTP config for contact form (server/index.ts)
## Fill these in locally as `.env` (never commit real secrets).

# If you deploy the email API separately (e.g. Vercel),
# set this in the frontend build environment to point the contact form to it.
# Example: VITE_CONTACT_API_URL="https://your-vercel-project.vercel.app/api/contact"
# (Leave unset for local dev proxy to /api/contact)
# VITE_CONTACT_API_URL=

# Server port (optional)
PORT=8787

# SMTP server (example values)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=VIPPRAFESTPRIVATELIMITED@GMAIL.COM
SMTP_PASS=YOUR_APP_PASSWORD_HERE

# Email envelope
SMTP_FROM="Vipprafest Website <VIPPRAFESTPRIVATELIMITED@GMAIL.COM>"
SMTP_TO=VIPPRAFESTPRIVATELIMITED@GMAIL.COM

# Auto-reply to the user (optional)
AUTO_REPLY_ENABLED=true
AUTO_REPLY_SUBJECT="We received your message — Vipprafest"
# AUTO_REPLY_BODY="Hi {{name}},\n\nThanks for contacting Vipprafest..."

